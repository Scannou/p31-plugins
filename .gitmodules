[submodule "libs/clap"]
	path = libs/clap
	url = https://github.com/free-audio/clap.git
[submodule "libs/clap-wrapper"]
	path = libs/clap-wrapper
	url = https://github.com/free-audio/clap-wrapper.git
[submodule "libs/vst3sdk"]
	path = libs/vst3sdk
	url = https://github.com/steinbergmedia/vst3sdk.git
[submodule "libs/AudioUnitSDK"]
	path = libs/AudioUnitSDK
	url = https://github.com/apple/AudioUnitSDK.git
[submodule "libs/rtaudio"]
	path = libs/rtaudio
	url = https://github.com/thestk/rtaudio.git
[submodule "libs/rtmidi"]
	path = libs/rtmidi
	url = https://github.com/thestk/rtmidi.git
