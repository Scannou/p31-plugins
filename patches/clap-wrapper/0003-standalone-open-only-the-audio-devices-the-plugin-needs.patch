+bool StandaloneHost::pluginWantsAudioInput()
+{
+  if (!clapPlugin || !clapPlugin->_plugin) return true;
+  auto p = clapPlugin->_plugin;
+  auto ext = (const StandaloneAudioIOExtension *)p->get_extension(p, kStandaloneAudioIOExtension);
+  return !ext || !ext->wants_input || ext->wants_input(p);
+}
+
+bool StandaloneHost::pluginWantsAudioOutput()
+{
+  if (!clapPlugin || !clapPlugin->_plugin) return true;
+  auto p = clapPlugin->_plugin;
+  auto ext = (const StandaloneAudioIOExtension *)p->get_extension(p, kStandaloneAudioIOExtension);
+  return !ext || !ext->wants_output || ext->wants_output(p);
+}
+
+bool StandaloneHost::audioInputMatchesPlugin()
+{
+  return audioInputUsed == (audioInputRequested && pluginWantsAudioInput());
+}
+
+void StandaloneHost::restartAudio()
+{
+  startAudioThreadOn(audioInputDeviceID, 2, audioInputRequested, audioOutputDeviceID, 2,
+                     audioOutputRequested, currentSampleRate);
+}
