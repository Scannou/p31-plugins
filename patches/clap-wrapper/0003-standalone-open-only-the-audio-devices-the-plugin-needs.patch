+// Plugin extension: the plugin tells the standalone which audio devices it
+// needs. Without the extension both are opened.
+static constexpr char kStandaloneAudioIOExtension[] = "clap-wrapper.standalone-audio-io/1";
+struct StandaloneAudioIOExtension
+{
+  // false while the plugin does not read its audio input: no input device
+  // is opened. [main-thread]
+  bool(CLAP_ABI *wants_input)(const clap_plugin_t *plugin);
+  // false when the plugin's output need not be played. With no input
+  // either, no audio stream is opened and process() is not called: an
+  // output-only stream on a device that also has inputs counts as recording
+  // for macOS and lights the microphone indicator. [main-thread]
+  bool(CLAP_ABI *wants_output)(const clap_plugin_t *plugin);
+};
