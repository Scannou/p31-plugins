-  this->_events.emplace_back(n);
+  // May run on any thread: stage the change for process() (see
+  // _pendingParams), never touching _events here.
+  while (_pendingParamsLock.test_and_set(std::memory_order_acquire))
+  {
+    // the audio thread or another writer holds it for a short copy
+  }
+  bool merged = false;
+  for (auto &e : _pendingParams)
