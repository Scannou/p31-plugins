+void ProcessAdapter::drainPendingParameters()
+{
+  if (_pendingParamsLock.test_and_set(std::memory_order_acquire)) return;  // a writer is busy
+  for (const auto &e : _pendingParams)
+  {
+    if (_events.size() == _events.capacity()) break;  // never reallocate here
+    _eventindices.emplace_back(_events.size());
+    _events.emplace_back(e);
+  }
+  _pendingParams.clear();
+  _pendingParamsLock.clear(std::memory_order_release);
+}
+
 void ProcessAdapter::process(ProcessData &data)
 {
+  drainPendingParameters();
+
