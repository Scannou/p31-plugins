+    {
+      e.param.value = value;
+      merged = true;
+      break;
+    }
+  }
+  if (!merged && _pendingParams.size() < _pendingParams.capacity()) _pendingParams.emplace_back(n);
+  _pendingParamsLock.clear(std::memory_order_release);
 }
