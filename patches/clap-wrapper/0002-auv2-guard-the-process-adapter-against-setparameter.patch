+namespace
+{
+// Spin lock guard for WrapAsAUV2::_processAdapterLock.
+struct AdapterLock
+{
+  explicit AdapterLock(std::atomic_flag &f) : flag(f)
+  {
+    while (flag.test_and_set(std::memory_order_acquire))
+    {
+    }
+  }
+  ~AdapterLock()
+  {
+    flag.clear(std::memory_order_release);
+  }
+  std::atomic_flag &flag;
+};
+}  // namespace
